-- =========================================================
-- EMPLOYEE MANAGEMENT SYSTEM
-- WHERE CLAUSE & FILTERING OPERATORS
-- TASKS 1 TO 60
-- =========================================================


-- TASK 1
-- Display all employees from Pune
SELECT *
FROM employees
WHERE city = 'Pune';


-- TASK 2
-- Display all employees from Mumbai
SELECT *
FROM employees
WHERE city = 'Mumbai';


-- TASK 3
-- Display all employees from IT department
SELECT *
FROM employees
WHERE department = 'IT';


-- TASK 4
-- Display all employees from HR department
SELECT *
FROM employees
WHERE department = 'HR';


-- TASK 5
-- Display all employees from Sales department
SELECT *
FROM employees
WHERE department = 'Sales';


-- TASK 6
-- Display all Active employees
SELECT *
FROM employees
WHERE status = 'Active';


-- TASK 7
-- Display all Inactive employees
SELECT *
FROM employees
WHERE status = 'Inactive';


-- TASK 8
-- Display employee whose ID is 103
SELECT *
FROM employees
WHERE employee_id = 103;


-- TASK 9
-- Display employee named Priya Sharma
SELECT *
FROM employees
WHERE employee_name = 'Priya Sharma';


-- TASK 10
-- Display employees with salary exactly 35000
SELECT *
FROM employees
WHERE salary = 35000;


-- TASK 11
-- Display employees who are NOT from Pune
SELECT *
FROM employees
WHERE city != 'Pune';


-- TASK 12
-- Display employees whose department is NOT Testing
SELECT *
FROM employees
WHERE department <> 'Testing';


-- TASK 13
-- Salary greater than 40000
SELECT *
FROM employees
WHERE salary > 40000;


-- TASK 14
-- Salary less than 35000
SELECT *
FROM employees
WHERE salary < 35000;


-- TASK 15
-- Salary greater than or equal to 50000
SELECT *
FROM employees
WHERE salary >= 50000;


-- TASK 16
-- Salary less than or equal to 30000
SELECT *
FROM employees
WHERE salary <= 30000;


-- TASK 17
-- Joined after January 1, 2025
SELECT *
FROM employees
WHERE joining_date > '2025-01-01';


-- TASK 18
-- Joined on or before December 31, 2024
SELECT *
FROM employees
WHERE joining_date <= '2024-12-31';


-- TASK 19
-- Employee ID greater than 110
SELECT *
FROM employees
WHERE employee_id > 110;


-- TASK 20
-- Display employee name and joining date
-- for employees who joined on/after January 1, 2026
SELECT employee_name, joining_date
FROM employees
WHERE joining_date >= '2026-01-01';


-- =========================================================
-- AND OPERATOR
-- =========================================================


-- TASK 21
-- Pune employees who are Active
SELECT *
FROM employees
WHERE city = 'Pune'
AND status = 'Active';


-- TASK 22
-- IT employees earning more than 50000
SELECT *
FROM employees
WHERE department = 'IT'
AND salary > 50000;


-- TASK 23
-- Mumbai employees who are Inactive
SELECT *
FROM employees
WHERE city = 'Mumbai'
AND status = 'Inactive';


-- TASK 24
-- Sales employees from Pune earning at least 42000
SELECT *
FROM employees
WHERE department = 'Sales'
AND city = 'Pune'
AND salary >= 42000;


-- TASK 25
-- HR employees who joined after June 1, 2025
SELECT *
FROM employees
WHERE department = 'HR'
AND joining_date > '2025-06-01';


-- TASK 26
-- Active employees with salary between 40000 and 70000
SELECT *
FROM employees
WHERE status = 'Active'
AND salary >= 40000
AND salary <= 70000;


-- TASK 27
-- Mumbai Testing employees earning more than 38000
SELECT *
FROM employees
WHERE city = 'Mumbai'
AND department = 'Testing'
AND salary > 38000;


-- TASK 28
-- Active employees who joined on/after 2026-01-01
-- and earn more than 45000
SELECT *
FROM employees
WHERE status = 'Active'
AND joining_date >= '2026-01-01'
AND salary > 45000;


-- =========================================================
-- OR AND NOT OPERATORS
-- =========================================================


-- TASK 29
-- Employees from Pune OR Mumbai
SELECT *
FROM employees
WHERE city = 'Pune'
OR city = 'Mumbai';


-- TASK 30
-- Employees from IT OR HR
SELECT *
FROM employees
WHERE department = 'IT'
OR department = 'HR';


-- TASK 31
-- Salary below 32000 OR above 60000
SELECT *
FROM employees
WHERE salary < 32000
OR salary > 60000;


-- TASK 32
-- Employees from Nashik OR salary above 55000
SELECT *
FROM employees
WHERE city = 'Nashik'
OR salary > 55000;


-- TASK 33
-- Employees who are NOT in HR
SELECT *
FROM employees
WHERE NOT department = 'HR';


-- TASK 34
-- Employees whose status is NOT Inactive
SELECT *
FROM employees
WHERE NOT status = 'Inactive';


-- TASK 35
-- Active employees from Pune OR Mumbai
SELECT *
FROM employees
WHERE (city = 'Pune' OR city = 'Mumbai')
AND status = 'Active';


-- TASK 36
-- Employees who are NOT from Pune
-- and earn more than 40000
SELECT *
FROM employees
WHERE city <> 'Pune'
AND salary > 40000;


-- =========================================================
-- BETWEEN AND IN
-- =========================================================


-- TASK 37
-- Salary between 35000 and 55000
SELECT *
FROM employees
WHERE salary BETWEEN 35000 AND 55000;


-- TASK 38
-- Salary NOT between 40000 and 65000
SELECT *
FROM employees
WHERE salary NOT BETWEEN 40000 AND 65000;


-- TASK 39
-- Employees who joined during 2025
SELECT *
FROM employees
WHERE joining_date BETWEEN '2025-01-01' AND '2025-12-31';


-- TASK 40
-- Employee IDs between 105 and 115
SELECT *
FROM employees
WHERE employee_id BETWEEN 105 AND 115;


-- TASK 41
-- Employees from IT, HR or Sales
SELECT *
FROM employees
WHERE department IN ('IT', 'HR', 'Sales');


-- TASK 42
-- Employees from Pune, Mumbai or Nagpur
SELECT *
FROM employees
WHERE city IN ('Pune', 'Mumbai', 'Nagpur');


-- TASK 43
-- Employees NOT in Testing or Support
SELECT *
FROM employees
WHERE department NOT IN ('Testing', 'Support');


-- TASK 44
-- Employees NOT from Mumbai or Nashik
SELECT *
FROM employees
WHERE city NOT IN ('Mumbai', 'Nashik');


-- TASK 45
-- Employees with specific IDs
SELECT *
FROM employees
WHERE employee_id IN (101, 105, 110, 115, 120);


-- TASK 46
-- IT or Sales employees
-- with salary between 45000 and 75000
SELECT *
FROM employees
WHERE department IN ('IT', 'Sales')
AND salary BETWEEN 45000 AND 75000;


-- =========================================================
-- LIKE OPERATOR
-- =========================================================


-- TASK 47
-- Names starting with A
SELECT *
FROM employees
WHERE employee_name LIKE 'A%';


-- TASK 48
-- Names starting with R
SELECT *
FROM employees
WHERE employee_name LIKE 'R%';


-- TASK 49
-- Names ending with a
SELECT *
FROM employees
WHERE employee_name LIKE '%a';


-- TASK 50
-- Names containing "sh"
SELECT *
FROM employees
WHERE employee_name LIKE '%sh%';


-- TASK 51
-- Names starting with P and ending with a
SELECT *
FROM employees
WHERE employee_name LIKE 'P%a';


-- TASK 52
-- Names having exactly 5 characters
SELECT *
FROM employees
WHERE employee_name LIKE '_____';


-- TASK 53
-- Names having 'a' as second character
SELECT *
FROM employees
WHERE employee_name LIKE '_a%';


-- TASK 54
-- Names NOT starting with R
SELECT *
FROM employees
WHERE employee_name NOT LIKE 'R%';


-- =========================================================
-- NULL CHECKING
-- =========================================================


-- TASK 55
-- Employees whose email is missing
SELECT *
FROM employees
WHERE email IS NULL;


-- TASK 56
-- Employees who have an email
SELECT *
FROM employees
WHERE email IS NOT NULL;


-- TASK 57
-- Pune employees whose email is missing
SELECT *
FROM employees
WHERE city = 'Pune'
AND email IS NULL;


-- TASK 58
-- Active employees with email
-- and salary greater than 40000
SELECT *
FROM employees
WHERE status = 'Active'
AND email IS NOT NULL
AND salary > 40000;


-- =========================================================
-- INDUSTRIAL CHALLENGE
-- =========================================================


-- TASK 59
-- Active employees
-- from Pune or Mumbai
-- IT or Sales department
-- salary between 40000 and 70000
-- joined after January 1, 2025

SELECT *
FROM employees
WHERE status = 'Active'
AND city IN ('Pune', 'Mumbai')
AND department IN ('IT', 'Sales')
AND salary BETWEEN 40000 AND 70000
AND joining_date > '2025-01-01';


-- TASK 60
-- Name starts with S or R
-- email is available
-- employee is Active
-- city is Pune or Nashik

SELECT *
FROM employees
WHERE (employee_name LIKE 'S%' OR employee_name LIKE 'R%')
AND email IS NOT NULL
AND status = 'Active'
AND city IN ('Pune', 'Nashik');
